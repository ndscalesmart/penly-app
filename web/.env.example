# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (never expose to the browser). Used by webhooks/payouts later.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic — AI drafting (Sprint 3, PENLY-013)
ANTHROPIC_API_KEY=sk-ant-...

# Stripe — payments & Connect (Sprint 4/5)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend — transactional email (Sprint 1: waitlist confirmation)
RESEND_API_KEY=re_...
# Until your domain is verified in Resend, leave this unset (defaults to
# onboarding@resend.dev). After verifying penly.co: RESEND_FROM="Penly <hello@penly.co>"
RESEND_FROM=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
